{
  "vim": {
    "enabled": true,
    "showLabel": true,
    "activeText": "vim",
    "inactiveText": "normal",
    "colorWhenActive": "green",
    "colorWhenInactive": "red"
  },
  "cache": {
    "enabled": true,
    "showLabel": true,
    "format": "percentage",
