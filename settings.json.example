{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "xxx",
    "ANTHROPIC_BASE_URL": "https://token-plan-ams.xiaomimimo.com/anthropic",
    "ANTHROPIC_MODEL": "mimo-v2.6-flash",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_DATA_DIR": "C:\\Users\\Yanis\\.claude",
    "PARRY_BIN": "C:/Users/Yanis/.cargo/bin/parry.exe",
    "PARRY_CONFIG": "C:\\Users\\Yanis\\.config\\parry\\config.toml",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "mimo-v2.6-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "mimo-v2.6-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "mimo-v2.6-flash",
    "MAX_THINKING_TOKENS": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(dev-browser *)"
    ]
  },
  "model": "mimo-v2.6-flash",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/parry-post-write.cjs",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Edit|Write|Explore|CreateTeam|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/argus-post-tool.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/output-filter.cjs",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/bash-pre-tool.cjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Explore|CreateTeam|Task|Agent|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/argus-pre-tool.cjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/protect-files.cjs",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/argus-session.cjs",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/wiki-session.cjs",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Yanis/.claude/hooks/argus-session-end.cjs",
            "timeout": 15000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node C:/Users/Yanis/.claude/statusline.mjs"
  },
  "enabledPlugins": {
    "agents@smite": true,
    "context7@claude-plugins-official": true,
    "core@smite": true,
    "essentials@smite": true,
    "exg@strike": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "glm-plan-usage@zai-coding-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "studio@smite": true,
    "ui@strike": true,
    "ponytail@ponytail": true,
    "agent-skills@addy-agent-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "smite": {
      "source": {
        "source": "github",
        "repo": "Pamacea/smite"
      }
    },
    "strike": {
      "source": {
        "source": "github",
        "repo": "Pamacea/strike"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  },
  "language": "French",
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx"
    }
  },
  "teammateMode": "tmux"
}
